            while ScriptAlive and _G.G_AutoCombo do
                local seq = tostring(_G.G_MacroSequence or _G.G_ComboSeq or "Z,X,C")
                local delay = math.clamp(tonumber(_G.G_ComboDelay) or 0.25, 0.05, 2)
                for part in string.gmatch(seq, "[^,]+") do
                    if not _G.G_AutoCombo then break end
                    local k = part:gsub("%s+",""):upper()
                    if k ~= "" then
                        pcall(function()
                            local vim = game:GetService("VirtualInputManager")
                            local kc = Enum.KeyCode[k]
                            if kc then
                                vim:SendKeyEvent(true, kc, false, game)
                                task.wait(0.04)
                                vim:SendKeyEvent(false, kc, false, game)
                            end
                        end)
                        task.wait(delay)
                    end
                end
                task.wait(0.05)
            end
            acTask = nil
        end)
        print("[月食] 自动连招 ON")
    end
    function StopAutoCombo()
