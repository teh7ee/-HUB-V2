                    else
                        local nm = string.lower(toolG.Name or "")
                        for _, k in ipairs({"gun","rifle","pistol","kabucha","acidum","serpent","flint","cannon","bazooka","magna","quad","soul","plasma","burst","sniper","shotgun"}) do
                            if nm:find(k, 1, true) then isGun = true break end
                        end
                    end
                end
                if isGun then
                    local skillKeyDown = false
                    pcall(function()
                        for _, sk in ipairs({"Z","X","C","V","F"}) do
                            if UIS:IsKeyDown(Enum.KeyCode[sk]) then skillKeyDown = true break end
                        end
                    end)
                    if not skillKeyDown then
                    local part = currentSilentAimTarget
                    if not part or not part.Parent then
                        local f = (_G.__Eclipse and _G.__Eclipse.GetClosestTargetToMouse) or rawget(_G, "GetClosestTargetToMouse")
                        if type(f) == "function" then
                            local ok, p = pcall(f)
                            if ok then part = p end
                        end
                    end
                    if part and part.Parent then
                        local tp = part.Position
                        local cp = Workspace.CurrentCamera.CFrame.Position
                        if key == "Hit" then return CFrame.new(tp)
                        elseif key == "Target" then return part
                        elseif key == "UnitRay" then return Ray.new(cp, (tp - cp).Unit)
                        elseif key == "Origin" then return cp
                        elseif key == "Direction" then return (tp - cp).Unit
                        end
                    end
                    end -- not skillKeyDown
                end
            end
            -- 原 M1 自瞄
            if not _G.G_SilentAimM1R then return oldIndex(self, key) end
            if not currentSilentAimTarget then return oldIndex(self, key) end
            local tp = currentSilentAimTarget.Position
            local cp = Workspace.CurrentCamera.CFrame.Position
            if key == "Hit" then return CFrame.new(tp)
            elseif key == "Target" then return currentSilentAimTarget
            elseif key == "UnitRay" then return Ray.new(cp, (tp - cp).Unit)
            elseif key == "Origin" then return cp
            elseif key == "Direction" then return (tp - cp).Unit
            end
            return oldIndex(self, key)
        end)
    end)
end

