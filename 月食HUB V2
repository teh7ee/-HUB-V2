local function KeyNameToEnum(name)
    if not name or name == "" or name == "None" or name == "无" then return nil end
    name = tostring(name)
    local ok, kc = pcall(function() return Enum.KeyCode[name] end)
    if ok and kc then return kc end
    -- 别名
    local aliases = {
        ["左Shift"] = "LeftShift", ["右Shift"] = "RightShift",
        ["左Ctrl"] = "LeftControl", ["右Ctrl"] = "RightControl",
        ["空格"] = "Space",
    }
    if aliases[name] then
        ok, kc = pcall(function() return Enum.KeyCode[aliases[name]] end)
        if ok and kc then return kc end
    end
    return nil
end

local function ToggleFlag(flag, startFn, stopFn)
    _G[flag] = not _G[flag]
    local on = _G[flag]
