local function GetBindNameFromInput(input)
    if not input then return nil end
    local uit = input.UserInputType
    if uit == Enum.UserInputType.Keyboard and input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then return input.KeyCode.Name end
    if uit == Enum.UserInputType.MouseButton1 then return "MouseButton1" end
    if uit == Enum.UserInputType.MouseButton2 then return "MouseButton2" end
    if uit == Enum.UserInputType.MouseButton3 then return "MouseButton3" end
    if uit == Enum.UserInputType.MouseButton4 then return "MouseButton4" end
    if uit == Enum.UserInputType.MouseButton5 then return "MouseButton5" end
    return nil
end
local function IsBindDown(name)
    name = tostring(name or "")
    if name=="" or name=="None" then return false end
    if name:find("MouseButton") then
        local ok,v = pcall(function() return UIS:IsMouseButtonPressed(Enum.UserInputType[name]) end)
        return ok and v
    end
    local ok,kc = pcall(function() return Enum.KeyCode[name] end)
    if ok and kc then local ok2,d=pcall(function() return UIS:IsKeyDown(kc) end); return ok2 and d end
    return false
end
local _kbLast = {}
local function FireKB(action)
    local n=tick()
    if _kbLast[action] and n-_kbLast[action]<0.35 then return end
    _kbLast[action]=n
    if not next(KeybindActions) then pcall(RegisterKeybindActions) end
    local fn = KeybindActions[action]
    if fn then print("[月食] 热键触发", action); local ok,e=pcall(fn); if not ok then warn("[月食]",e) end end
end
track(UIS.InputBegan:Connect(function(input, gp)
    if not ScriptAlive or gp or UIS:GetFocusedTextBox() then return end
    if _G.__KeyCaptureAction then return end
    local pressed = GetBindNameFromInput(input)
    if not pressed then return end
    for action,keyName in pairs(_G.G_Keybinds or {}) do
        if keyName and keyName~="None" and tostring(keyName)==pressed then FireKB(action) end
    end
end))
