-- TP
function DoTPBehind()
    if not ScriptAlive then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        print("[月食] TP失败: 无角色")
        return
    end
    local targetPart = currentSilentAimTarget
    if not targetPart then
        pcall(function()
            if GetClosestTargetToMouse then targetPart = GetClosestTargetToMouse() end
        end)
    end
    -- 指定玩家
    if not targetPart and _G.G_SilentAimSelectedPlayer and _G.G_SilentAimSelectedPlayer ~= "" then
        local plr = Players:FindFirstChild(_G.G_SilentAimSelectedPlayer)
        if plr and plr.Character then
            targetPart = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
        end
    end
    -- 最近敌人玩家
    if not targetPart then
        local best, bd = nil, 1e9
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local r = plr.Character:FindFirstChild("HumanoidRootPart")
                local h = plr.Character:FindFirstChildOfClass("Humanoid")
                if r and h and h.Health > 0 then
                    local d = (r.Position - hrp.Position).Magnitude
                    if d < bd then best, bd = r, d end
                end
            end
        end
        targetPart = best
    end
    -- 最近小怪
    if not targetPart then
        local folder = Workspace:FindFirstChild("Enemies")
        if folder then
            local best, bd = nil, 1e9
            for _, m in ipairs(folder:GetChildren()) do
                local r = m:FindFirstChild("HumanoidRootPart")
                local h = m:FindFirstChildOfClass("Humanoid")
                if r and h and h.Health > 0 then
                    local d = (r.Position - hrp.Position).Magnitude
                    if d < bd then best, bd = r, d end
                end
            end
            targetPart = best
        end
    end
    if not targetPart then
        print("[月食] TP失败: 无目标（开自瞄锁人或靠近敌人）")
        return
    end
    local tModel = targetPart.Parent
    local tHRP = (tModel and tModel:FindFirstChild("HumanoidRootPart")) or targetPart
    local dist = math.clamp(tonumber(_G.G_TPDistance) or 4, 2, 80)
    local look = tHRP.CFrame.LookVector
    local pos = tHRP.Position - look * dist + Vector3.new(0, 1.5, 0)
    local goal = CFrame.new(pos, tHRP.Position)
    -- 多次写入，对抗服务端短暂回弹
    hrp.CFrame = goal
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.defer(function()
        if hrp and hrp.Parent then
            hrp.CFrame = goal
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end)
    task.delay(0.05, function()
        if hrp and hrp.Parent then
            hrp.CFrame = goal
        end
    end)
    print("[月食] TP ->", tModel and tModel.Name or "target", "距离", dist)
end

