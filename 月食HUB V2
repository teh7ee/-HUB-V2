do
    local NoclipConnection, NoclipHB, NoclipParts, NoclipChar, NoclipAddConn

    local function forcePartNoClip(part)
        if not part or not part:IsA("BasePart") then return end
        part.CanCollide = false
        pcall(function() part.CanTouch = false end)
        pcall(function() part.CanQuery = false end)
    end

    local function rebuildNoclipCache(char)
        NoclipChar = char
        NoclipParts = {}
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                table.insert(NoclipParts, d)
                forcePartNoClip(d)
            end
        end
        if NoclipAddConn then pcall(function() NoclipAddConn:Disconnect() end) end
        NoclipAddConn = char.DescendantAdded:Connect(function(desc)
            if desc:IsA("BasePart") then
                table.insert(NoclipParts, desc)
                forcePartNoClip(desc)
            end
        end)
        -- 人型状态：减少被墙卡住
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Running)
                hum.PlatformStand = false
            end)
        end
    end

    local function applyNoclipFrame()
        if not ScriptAlive or not _G.G_Noclip then return end
        local char = LocalPlayer.Character
        if not char then return end
        if not NoclipParts or NoclipChar ~= char then
            rebuildNoclipCache(char)
        end
        for i = #NoclipParts, 1, -1 do
            local part = NoclipParts[i]
            if not part or not part.Parent then
                table.remove(NoclipParts, i)
            else
                if part.CanCollide then
                    forcePartNoClip(part)
                else
                    -- 仍每帧强制，防 BF 回写
                    forcePartNoClip(part)
                end
            end
        end
    end

    function StartNoclip()
        _G.G_Noclip = true
        if NoclipConnection then return end
        local char = LocalPlayer.Character
        if char then rebuildNoclipCache(char) end
        -- Stepped：物理步前关碰撞（关键）
        NoclipConnection = RunService.Stepped:Connect(function()
            applyNoclipFrame()
        end)
        -- Heartbeat：再写一次，防服务器/客户端回写
        NoclipHB = RunService.Heartbeat:Connect(function()
            applyNoclipFrame()
        end)
        if track then
            pcall(track, NoclipConnection)
            pcall(track, NoclipHB)
        end
        print("[月食] Noclip ON (Stepped+Heartbeat 强制)")
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Noclip", Content = "已开启(双循环)", Duration = 1.5 })
            end
        end)
    end

    function StopNoclip()
        _G.G_Noclip = false
        if NoclipConnection then pcall(function() NoclipConnection:Disconnect() end); NoclipConnection = nil end
        if NoclipHB then pcall(function() NoclipHB:Disconnect() end); NoclipHB = nil end
        if NoclipAddConn then pcall(function() NoclipAddConn:Disconnect() end); NoclipAddConn = nil end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                pcall(function()
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = true
                        part.CanTouch = true
                    end
                end)
            end
        end
        NoclipParts, NoclipChar = nil, nil
        print("[月食] Noclip OFF")
    end

    LocalPlayer.CharacterAdded:Connect(function(char)
        NoclipParts, NoclipChar = nil, nil
        if NoclipAddConn then pcall(function() NoclipAddConn:Disconnect() end); NoclipAddConn = nil end
        if _G.G_Noclip then
            task.defer(function()
                if char.Parent and _G.G_Noclip then rebuildNoclipCache(char) end
            end)
        end
    end)

    local espObjects = {} -- [player] = { gui, highlight, text, hpFill }

    local function destroyESP(player)
        local o = espObjects[player]
        if not o then return end
        pcall(function() if o.gui then o.gui:Destroy() end end)
        pcall(function() if o.highlight then o.highlight:Destroy() end end)
        espObjects[player] = nil
    end

    function ClearESP()
        for plr, _ in pairs(espObjects) do
            destroyESP(plr)
        end
    end

    local function createESP(player)
        if player == LocalPlayer then return end
        destroyESP(player)
        local char = player.Character
        if not char then return end
        local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if not head then return end
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "EclipseESP"
