local function DeepCopy(v)
    if type(v) ~= "table" then return v end
    local c = {}
    for k, x in pairs(v) do c[k] = DeepCopy(x) end
    return c
end

local function EnsureConfigDir()
    if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
        if not isfolder(CONFIG_DIR) then
            pcall(makefolder, CONFIG_DIR)
        end
        return true
    end
    return false
end

local function SafeReadJson(path)
    if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then return nil end
    if not isfile(path) then return nil end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if ok and type(data) == "table" then return data end
    return nil
end

local function SafeWriteJson(path, tbl)
    if typeof(writefile) ~= "function" then
        warn("[Config] 当前 executor 无 writefile")
        return false
    end
    EnsureConfigDir()
    local ok, err = pcall(function()
        writefile(path, HttpService:JSONEncode(tbl))
    end)
    if not ok then warn("[Config] write fail", err) end
    return ok
end

local function LoadIndex()
    local idx = SafeReadJson(CONFIG_INDEX)
    if type(idx) ~= "table" then
        idx = { autoload = DEFAULT_CONFIG_NAME, configs = { DEFAULT_CONFIG_NAME } }
    end
    if type(idx.configs) ~= "table" then idx.configs = { DEFAULT_CONFIG_NAME } end
    if type(idx.autoload) ~= "string" or idx.autoload == "" then idx.autoload = DEFAULT_CONFIG_NAME end
    return idx
end

local function SaveIndex(idx)
    return SafeWriteJson(CONFIG_INDEX, idx)
end

local function ConfigPath(name)
    name = tostring(name or DEFAULT_CONFIG_NAME):gsub("[^%w%-%_]", "_")
    if name == "" then name = DEFAULT_CONFIG_NAME end
    return CONFIG_DIR .. "/" .. name .. ".json", name
end

local function CollectConfig()
    local data = {}
    for _, key in ipairs(ConfigKeys) do
        if key ~= "G_SilentAimSelectedPlayer" and _G[key] ~= nil then
            data[key] = DeepCopy(_G[key])
        end
    end
    data.FOVMode = _G.FOVMode
    return data
end

local function ApplyConfigData(data)
    if type(data) ~= "table" then return end
    for _, key in ipairs(ConfigKeys) do
        if key ~= "G_SilentAimSelectedPlayer" and data[key] ~= nil then
            _G[key] = DeepCopy(data[key])
        end
    end
    if data.FOVMode then
        _G.FOVMode = data.FOVMode
        _G.G_SilentAimFOVMode = data.FOVMode
    end
    -- 每次加载配置清空指定玩家，防止自瞄失效
    _G.G_SilentAimSelectedPlayer = ""
    _G.G_SilentAimMethod = "FOV圈内"
    _G.G_SelectPlayerEnabled = false
end

local function ListConfigNames()
    local idx = LoadIndex()
    local names = {}
    for _, n in ipairs(idx.configs) do
        if type(n) == "string" then table.insert(names, n) end
    end
    if #names == 0 then names = { DEFAULT_CONFIG_NAME } end
    return names, idx.autoload
end

local function SaveConfigAs(name)
    local path, clean = ConfigPath(name)
    local ok = SafeWriteJson(path, CollectConfig())
    if not ok then return false, clean end
    local idx = LoadIndex()
    local found = false
    for _, n in ipairs(idx.configs) do
        if n == clean then found = true break end
    end
    if not found then table.insert(idx.configs, clean) end
    SaveIndex(idx)
    print("[Config] saved:", clean)
    return true, clean
end

local function LoadConfigByName(name)
    local path, clean = ConfigPath(name)
    local data = SafeReadJson(path)
    if not data then
        -- 兼容旧单文件
        local legacy = SafeReadJson("SilentAim_Stealth_Config.json")
        if legacy then
            ApplyConfigData(legacy)
            print("[Config] loaded legacy file as", clean)
            return true, clean
        end
        warn("[Config] not found:", clean)
        return false, clean
    end
    ApplyConfigData(data)
    print("[Config] loaded:", clean)
    return true, clean
end

local function SetAutoload(name)
    local _, clean = ConfigPath(name)
    local idx = LoadIndex()
    idx.autoload = clean
    local found = false
    for _, n in ipairs(idx.configs) do
        if n == clean then found = true break end
    end
    if not found then table.insert(idx.configs, clean) end
    SaveIndex(idx)
    print("[Config] autoload =", clean)
    return clean
end

local function DeleteConfig(name)
    local path, clean = ConfigPath(name)
    if clean == DEFAULT_CONFIG_NAME then
        warn("[Config] 不建议删除 default")
    end
    if typeof(delfile) == "function" and typeof(isfile) == "function" and isfile(path) then
        pcall(delfile, path)
    end
    local idx = LoadIndex()
    local newList = {}
    for _, n in ipairs(idx.configs) do
        if n ~= clean then table.insert(newList, n) end
    end
    if #newList == 0 then newList = { DEFAULT_CONFIG_NAME } end
    idx.configs = newList
    if idx.autoload == clean then idx.autoload = newList[1] end
    SaveIndex(idx)
    return true
end

