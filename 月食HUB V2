local M1_RegisterAttack, M1_RegisterHit, M1_Net = nil, nil, nil
local fastM1Conn = nil

local function M1_RefreshRemotes()
    pcall(function()
        local function findRemote(root, names)
            if not root then return nil end
            for _, n in ipairs(names) do
                local r = root:FindFirstChild(n)
                if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then return r end
            end
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                    for _, n in ipairs(names) do
                        if d.Name == n or d.Name:find(n, 1, true) then return d end
                    end
                end
            end
            return nil
        end
        local Modules = ReplicatedStorage:FindFirstChild("Modules")
        local Net = Modules and Modules:FindFirstChild("Net")
        M1_Net = Net
        local attackNames = {"RE/RegisterAttack", "RegisterAttack"}
        local hitNames = {"RE/RegisterHit", "RegisterHit"}
        M1_RegisterAttack = findRemote(Net, attackNames) or findRemote(ReplicatedStorage, attackNames)
        M1_RegisterHit = findRemote(Net, hitNames) or findRemote(ReplicatedStorage, hitNames)
        if M1_RegisterAttack and M1_RegisterHit then
            print("[月食] M1 Remote OK")
        else
            warn("[月食] M1 Remote 未齐 Attack=", M1_RegisterAttack, "Hit=", M1_RegisterHit)
        end
    end)
end

local function M1_GetHitList(preferPart)
    local list = {}
    local main = nil
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return list, main end

    local function push(model)
        if not model or model == char then return end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then return end
        if (root.Position - myRoot.Position).Magnitude > 100 then return end
        local part = model:FindFirstChild("Head") or root
        table.insert(list, { model, part })
        if not main then main = part end
    end

    if preferPart and preferPart.Parent then
        push(preferPart.Parent)
        main = preferPart.Parent:FindFirstChild("Head") or preferPart
    end

    if _G.G_SilentAimTargetPlayers ~= false then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                if not _G.G_SilentAimTeamCheck or (IsSilentAimEnemy and IsSilentAimEnemy(plr)) then
                    push(plr.Character)
                end
            end
        end
    end
    if _G.G_SilentAimTargetMobs ~= false then
        local folder = Workspace:FindFirstChild("Enemies")
        if folder then
            for _, m in ipairs(folder:GetChildren()) do push(m) end
        end
    end
    return list, main
end


local function FireFastM1Once()
    if not M1_RegisterAttack or not M1_RegisterHit then
        M1_RefreshRemotes()
    end
    if not M1_RegisterAttack or not M1_RegisterHit then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not char or not hum or hum.Health <= 0 then return end

    local OthersEnemies = {}
    local BasePart = nil
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position

    local function push(model)
        if not model or model == char then return end
        local h = model:FindFirstChildOfClass("Humanoid")
        local r = model:FindFirstChild("HumanoidRootPart")
        if not h or not r or h.Health <= 0 then return end
        if (r.Position - myPos).Magnitude > 120 then return end
        local part = model:FindFirstChild("Head") or r
        -- 随机有效部位（RJR 思路，提高命中）
        for _, n in ipairs({"Head", "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso"}) do
            local p = model:FindFirstChild(n)
            if p then part = p break end
        end
        table.insert(OthersEnemies, { model, part })
        if not BasePart then BasePart = part end
    end

    -- 优先当前自瞄
    if currentSilentAimTarget and currentSilentAimTarget.Parent then
        push(currentSilentAimTarget.Parent)
        BasePart = currentSilentAimTarget
    end
    if _G.G_SilentAimTargetPlayers ~= false then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                push(plr.Character)
            end
        end
    end
    if _G.G_SilentAimTargetMobs ~= false then
        for _, folderName in ipairs({"Enemies", "NPCs"}) do
            local folder = Workspace:FindFirstChild(folderName)
            if folder then
                for _, m in ipairs(folder:GetChildren()) do push(m) end
            end
        end
    end

    if not BasePart or #OthersEnemies == 0 then
        -- 无目标仍 Activate，保本地动画
        if tool then pcall(function() tool:Activate() end) end
        return
    end
    -- RJR 同款参数：Attack(0.3) + Hit(BasePart, list)
    pcall(function()
        M1_RegisterAttack:FireServer(0.3)
        M1_RegisterHit:FireServer(BasePart, OthersEnemies)
    end)
    if tool and tostring(tool.ToolTip or "") ~= "Gun" then
        pcall(function() tool:Activate() end)
    end
end


