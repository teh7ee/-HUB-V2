do
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    local FS, IS = "FireServer", "InvokeServer"
    mt.__namecall = newcclosure(function(self, ...)
        -- 强力 namecall 默认关闭，避免技能有动作无特效进CD
        if not ScriptAlive or not _G.G_SilentAimSkill or not _G.G_UseNamecallAim then
            return oldNamecall(self, ...)
        end
        local method = getnamecallmethod()
        if method ~= FS and method ~= IS then return oldNamecall(self, ...) end
        if not IsCurrentSkillEnabled() or not _G.G_SilentAimTargetPos then return oldNamecall(self, ...) end
        local sName = tostring(self)
        if sName ~= "RemoteEvent" and sName ~= "CommE" and sName ~= "RemoteFunction" then
            return oldNamecall(self, ...)
        end
        local args = { ... }
        local tp = _G.G_SilentAimTargetPos
        if typeof(tp) ~= "Vector3" then return oldNamecall(self, ...) end
        -- 只改最后两个位置参数（兼顾多点技能，避免全改炸远程）
        local changed = false
        local left = 2
        for i = #args, 1, -1 do
            if left <= 0 then break end
            local ty = typeof(args[i])
            if ty == "Vector3" then
                args[i] = tp
                changed = true
                left = left - 1
            elseif ty == "CFrame" then
                args[i] = CFrame.new(tp)
                changed = true
                left = left - 1
            end
        end
        if not changed then return oldNamecall(self, ...) end
        return oldNamecall(self, unpack(args))
    end)
    setreadonly(mt, true)
end

