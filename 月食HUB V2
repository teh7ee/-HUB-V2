    local cur = humanoid.WalkSpeed
    if _G.G_translateAccel and _G.G_SpeedAdd and _G.G_SpeedAdd > 0 then
        local approx = cur - _G.G_SpeedAdd
        if approx >= 8 and approx <= 40 then
            BaseWalkSpeed = approx
            return
        end
    end
    if cur >= 8 and cur <= 40 then
        BaseWalkSpeed = cur
    else
        BaseWalkSpeed = 16
    end
end

local function ApplySpeedBoost(humanoid)
    if not humanoid or not _G.G_translateAccel then return end
    local add = math.clamp(tonumber(_G.G_SpeedAdd) or 0, SPEED_ADD_MIN, SPEED_ADD_MAX)
    -- 隐蔽：微抖动 + 小步逼近，少一次顶满整数值
    local jitter = (math.random() - 0.5) * 0.4
    local target = math.max(1, BaseWalkSpeed + add + jitter)
    local cur = humanoid.WalkSpeed
    if math.abs(cur - target) < 0.45 then return end
    if cur < target then
        humanoid.WalkSpeed = math.min(target, cur + math.max(0.6, add * 0.06 + 0.5))
    else
        humanoid.WalkSpeed = target
    end
end

-- 兼容旧名
local function ApplyTranslateWalkSpeed(humanoid)
    ApplySpeedBoost(humanoid)
end

local function StartTranslateAccel()
    local function bind(char)
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        CaptureBaseWalkSpeed(humanoid)
        ApplySpeedBoost(humanoid)
        if translateWalkSpeedConn then pcall(function() translateWalkSpeedConn:Disconnect() end) end
        translateWalkSpeedConn = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if not ScriptAlive or not _G.G_translateAccel or humanoid.Health <= 0 then return end
            local expected = math.max(1, BaseWalkSpeed + (tonumber(_G.G_SpeedAdd) or 0))
            if math.abs(humanoid.WalkSpeed - expected) > 0.5 then
                if humanoid.WalkSpeed < expected and humanoid.WalkSpeed >= 8 and humanoid.WalkSpeed <= 40 then
                    BaseWalkSpeed = humanoid.WalkSpeed
                end
                ApplySpeedBoost(humanoid)
            end
        end)
        track(translateWalkSpeedConn)
    end
    if LocalPlayer.Character then bind(LocalPlayer.Character) end
    if translateConnection then pcall(function() translateConnection:Disconnect() end) end
    translateConnection = LocalPlayer.CharacterAdded:Connect(bind)
    track(translateConnection)
end

local function StopTranslateAccel()
    _G.G_translateAccel = false
    if translateWalkSpeedConn then pcall(function() translateWalkSpeedConn:Disconnect() end); translateWalkSpeedConn = nil end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.WalkSpeed = BaseWalkSpeed end) end
end

local speedHB = nil
