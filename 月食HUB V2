local function DoAHKCycle()
    local steps = {}
    for part in string.gmatch(tostring(_G.G_AHKCycleSeq or "Z,X,C"), "[^,]+") do
        local s = part:gsub("%s+",""):upper()
        if s ~= "" then table.insert(steps, s) end
    end
    if #steps == 0 then steps = {"Z","X","C"} end
    local idx = math.clamp(tonumber(_G.G_AHKCycleIndex) or 1, 1, #steps)
    local step = steps[idx]
    print("[月食] AHK", step, idx)
    for i=1,#step do
        local ch = step:sub(i,i)
        if ch:match("%a") then
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                local kc = Enum.KeyCode[ch]
                if kc then vim:SendKeyEvent(true,kc,false,game); task.wait(0.05); vim:SendKeyEvent(false,kc,false,game) end
            end)
            task.wait(0.03)
        end
    end
    idx = idx % #steps + 1
    _G.G_AHKCycleIndex = idx
end
