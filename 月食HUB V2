        if not hrp or not hum or not cam or hum.Health <= 0 then return end
        pcall(function()
            hum.PlatformStand = true
            hum.AutoRotate = false
            hum.WalkSpeed = 0
        end)
        local bv, bg = ensureMovers(hrp)
        local spd = math.clamp(tonumber(_G.G_FlySpeed) or 80, 10, 300)
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
            dir = dir - Vector3.yAxis
        end
        local vel = Vector3.zero
        if dir.Magnitude > 0 then
            vel = dir.Unit * spd
            -- CFrame 推进（防速度被清）
            hrp.CFrame = hrp.CFrame + vel * math.clamp(dt, 0, 0.05)
