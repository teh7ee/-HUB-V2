local function HandleChatCommand(msg)
    if type(msg) ~= "string" then return end
    local lower = msg:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if lower == "/e hide" or lower == "/ehide" then
        SetHiddenMode(true)
        return
    elseif lower == "/e show" or lower == "/eshow" then
        SetHiddenMode(false)
        return
    end
    -- /e speed 80  或  /e spd 80  ·  /e dash 25
    local cmd, num = lower:match("^/e%s+(%a+)%s+([%d%.]+)$")
    if not cmd then cmd, num = lower:match("^/e(%a+)%s+([%d%.]+)$") end
    if cmd and num then
        local v = tonumber(num)
        if not v then return end
        if cmd == "speed" or cmd == "spd" or cmd == "s" then
            _G.G_SpeedAdd = math.clamp(v, SPEED_ADD_MIN or 0, SPEED_ADD_MAX or 500)
            _G.G_translateSpeed = _G.G_SpeedAdd
            if not _G.G_translateAccel then
                _G.G_translateAccel = true
                pcall(function() if StartTranslateAccel then StartTranslateAccel() end end)
                pcall(function() if StartSpeedHB then StartSpeedHB() end end)
            else
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and ApplyTranslateWalkSpeed then ApplyTranslateWalkSpeed(hum) end
            end
            print("[月食] 速度加量 =", _G.G_SpeedAdd)
        elseif cmd == "dash" or cmd == "d" then
            _G.G_DashAdd = math.clamp(v, DASH_ADD_MIN or 0, DASH_ADD_MAX or 200)
            _G.G_DashLength = _G.G_DashAdd
            _G.G_DashLengthEnabled = true
            pcall(function() if ManageDashLength then ManageDashLength() end end)
            print("[月食] Dash加量 =", _G.G_DashAdd)
        end
    end
end
