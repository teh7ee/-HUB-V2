                local thrp = npc:FindFirstChild("HumanoidRootPart")
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if thrp and hum and hum.Health > 0 and (thrp.Position - myHRP.Position).Magnitude < 500 then
