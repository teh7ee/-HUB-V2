local function FruitM1_FireOnce()
    local fruit = GetEquippedFruitTool()
    if not fruit then return end
    -- 装备果实到角色上才能放
    local char = LocalPlayer.Character
    if char and fruit.Parent ~= char then
        pcall(function() fruit.Parent = char end)
        task.wait(0.05)
    end
    local remote = fruit:FindFirstChild("LeftClickRemote")
    if not remote then
        for _, d in ipairs(fruit:GetDescendants()) do
            if d.Name == "LeftClickRemote" or (d:IsA("RemoteEvent") and d.Name:lower():find("left") and d.Name:lower():find("click")) then
                remote = d
                break
            end
        end
    end
    if not remote then return end
    local myHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local function fireAt(pos)
        local dir = (pos - myHRP.Position)
        if dir.Magnitude < 0.1 then dir = myHRP.CFrame.LookVector else dir = dir.Unit end
        pcall(function()
            remote:FireServer(Vector3.new(dir.X, dir.Y, dir.Z), 1, true)
        end)
    end
    -- 优先自瞄目标
    if currentSilentAimTarget then
        fireAt(currentSilentAimTarget.Position)
        return
    end
    if _G.G_SilentAimTargetPlayers ~= false then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local thrp = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if thrp and hum and hum.Health > 0 and (thrp.Position - myHRP.Position).Magnitude < 500 then
                    fireAt(thrp.Position)
                end
            end
        end
    end
    if _G.G_SilentAimTargetMobs ~= false then
        local folder = Workspace:FindFirstChild("Enemies")
        if folder then
            for _, npc in ipairs(folder:GetChildren()) do
                local thrp = npc:FindFirstChild("HumanoidRootPart")
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if thrp and hum and hum.Health > 0 and (thrp.Position - myHRP.Position).Magnitude < 500 then
                    fireAt(thrp.Position)
                end
            end
        end
    end
end

