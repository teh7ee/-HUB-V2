local function PressKeySim(keyName)
    keyName = tostring(keyName or ""):upper()
    if keyName == "" then return end
    local kc = nil
    pcall(function() kc = Enum.KeyCode[keyName] end)
    if not kc then return end
    -- 多通道：部分注入器 VIM 无效，部分 keypress 无效
    local ok = false
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        if vim then
            vim:SendKeyEvent(true, kc, false, game)
            task.wait(0.04)
            vim:SendKeyEvent(false, kc, false, game)
            ok = true
        end
    end)
    if not ok then
        pcall(function()
            if keypress and keyrelease then
                keypress(kc); task.wait(0.04); keyrelease(kc)
                ok = true
            end
        end)
    end
    pcall(function()
        if type(key_press) == "function" and type(key_release) == "function" then
            key_press(kc); task.wait(0.04); key_release(kc)
        end
    end)
end

local function RunMacroOnce()
    local seq = tostring(_G.G_MacroSequence or "Z,X,C")
    local delay = math.clamp(tonumber(_G.G_MacroDelay) or 0.25, 0.05, 2)
    for part in string.gmatch(seq, "[^,]+") do
        if not ScriptAlive or not _G.G_MacroEnabled then return end
        local k = part:gsub("%s+", ""):upper()
        if k ~= "" then
            PressKeySim(k)
            -- 技能自瞄窗口：标记按键
            if SkillHeld and SkillPressTime then
                SkillHeld[k] = true
                SkillPressTime[k] = tick()
                LastSkillPressed = k
                task.delay(0.2, function()
                    if SkillHeld then SkillHeld[k] = false end
                end)
            end
            task.wait(delay)
        end
    end
end

local function StopMacro()
    _G.G_MacroEnabled = false
    macroConn = nil
end

local function StartMacro()
    if macroConn then return end
    _G.G_MacroEnabled = true
    macroConn = task.spawn(function()
        print("[月食] 宏启动", _G.G_MacroSequence)
        repeat
            RunMacroOnce()
            if not _G.G_MacroLoop then break end
            task.wait(0.05)
        until not ScriptAlive or not _G.G_MacroEnabled or not _G.G_MacroLoop
