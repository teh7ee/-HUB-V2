-- 针对/击杀记录
_G.G_CombatLog = _G.G_CombatLog or { targeted = {}, killed = {} }
local function CombatLogAdd(kind, name)
    if not name or name == "" then return end
    _G.G_CombatLog = _G.G_CombatLog or { targeted = {}, killed = {} }
    local list = _G.G_CombatLog[kind]
    if type(list) ~= "table" then list = {}; _G.G_CombatLog[kind] = list end
    -- 去重移到最前
    for i = #list, 1, -1 do
        if list[i] == name then table.remove(list, i) end
    end
    table.insert(list, 1, name)
    while #list > 30 do table.remove(list) end
end

local function track(conn)
    if conn then table.insert(ConnBag, conn) end
    return conn
end

-- ========== 全局 API 表（解决 local 定义顺序问题）==========
_G.__Eclipse = _G.__Eclipse or {}
local function EclipseCall(name, ...)
    local E = _G.__Eclipse
    local f = (type(E) == "table" and E[name]) or rawget(_G, name)
    if type(f) == "function" then
        return f(...)
    end
    return nil
end

ESPDrawings = ESPDrawings or {}
function ClearESP()
    ESPDrawings = ESPDrawings or {}
    for k, d in pairs(ESPDrawings) do
        pcall(function()
            if type(d) == "table" then
                for _, x in pairs(d) do
                    pcall(function()
                        if x and x.Remove then x:Remove() elseif x and x.Destroy then x:Destroy() end
                    end)
                end
            elseif d and d.Remove then d:Remove()
            end
        end)
        ESPDrawings[k] = nil
    end
end
_G.__Eclipse = _G.__Eclipse or {}
_G.__Eclipse.ClearESP = ClearESP

local function EclipseSet(name, fn)
    if type(fn) == "function" then
        _G.__Eclipse = _G.__Eclipse or {}
        _G.__Eclipse[name] = fn
        rawset(_G, name, fn)
    end
end


