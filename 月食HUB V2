        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.TextSize = 14
        text.Font = Enum.Font.GothamBold
        text.TextStrokeTransparency = 0.4
        text.TextColor3 = Color3.fromRGB(255, 80, 80)
        text.Text = player.Name
        text.Parent = billboard
        local hpBar = Instance.new("Frame")
        hpBar.Size = UDim2.new(0.8, 0, 0, 5)
        hpBar.Position = UDim2.new(0.1, 0, 1, -8)
        hpBar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        hpBar.BorderSizePixel = 0
        hpBar.Parent = billboard
        local hpFill = Instance.new("Frame")
        hpFill.Size = UDim2.new(1, 0, 1, 0)
        hpFill.BackgroundColor3 = Color3.fromRGB(0, 220, 80)
        hpFill.BorderSizePixel = 0
        hpFill.Parent = hpBar
        local hl = nil
        pcall(function()
            hl = Instance.new("Highlight")
            hl.FillTransparency = 0.7
            hl.OutlineTransparency = 0.2
            hl.FillColor = Color3.fromRGB(255, 60, 60)
            hl.OutlineColor = Color3.fromRGB(255, 120, 120)
            hl.Adornee = char
            hl.Parent = char
        end)
        espObjects[player] = { gui = billboard, highlight = hl, text = text, hpFill = hpFill, hpBar = hpBar }
    end

    local espLoop
    function StartESP()
        _G.G_ESP = true
        if espLoop then return end
        espLoop = RunService.Heartbeat:Connect(function()
            if not ScriptAlive or not _G.G_ESP then return end
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local seen = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    seen[plr] = true
                    local char = plr.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if char and hum and hum.Health > 0 then
                        if not espObjects[plr] or not espObjects[plr].gui or not espObjects[plr].gui.Parent then
                            createESP(plr)
                        end
                        local o = espObjects[plr]
                        if o and o.text then
                            local dist = ""
                            if myHRP then
                                local hrp = char:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    dist = string.format(" %.0fm", (hrp.Position - myHRP.Position).Magnitude)
                                end
                            end
                            o.text.Text = string.format("%s [%.0f]%s", plr.Name, hum.Health, dist)
                            if o.hpFill and hum.MaxHealth > 0 then
                                o.hpFill.Size = UDim2.new(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 0, 1, 0)
                            end
                            -- 重生后 Adornee 丢了
                            local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                            if o.gui and head and o.gui.Adornee ~= head then
                                o.gui.Adornee = head
                                o.gui.Parent = head
                            end
                        end
                    else
                        destroyESP(plr)
                    end
                end
            end
            for plr, _ in pairs(espObjects) do
                if not seen[plr] then destroyESP(plr) end
            end
        end)
        if track then pcall(track, espLoop) end
        print("[月食] ESP ON (RJR BillboardGui)")
    end

    function StopESP()
        _G.G_ESP = false
        if espLoop then pcall(function() espLoop:Disconnect() end); espLoop = nil end
        ClearESP()
        print("[月食] ESP OFF")
    end

    Players.PlayerRemoving:Connect(function(plr) destroyESP(plr) end)

    -- 同步：只改 flag 也会启动
    track(RunService.Heartbeat:Connect(function()
        if _G.G_ESP and not espLoop then StartESP() end
        if not _G.G_ESP and espLoop then StopESP() end
        if _G.G_Noclip and not NoclipConnection then StartNoclip() end
        if not _G.G_Noclip and (NoclipConnection or NoclipHB) then StopNoclip() end
    end))

    _G.__Eclipse = _G.__Eclipse or {}
    _G.__Eclipse.StartNoclip = StartNoclip
    _G.__Eclipse.StopNoclip = StopNoclip
    _G.__Eclipse.StartESP = StartESP
    _G.__Eclipse.StopESP = StopESP
    _G.__Eclipse.ClearESP = ClearESP
end
print("[月食] RJR 同款 ESP(Billboard) + Noclip 已挂载")
