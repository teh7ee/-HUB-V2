-- Speed：在原 WalkSpeed 上加 G_SpeedAdd（用户参考版）
local translateWalkSpeedConn, translateConnection = nil, nil
local SPEED_ADD_MIN, SPEED_ADD_MAX = 0, 500
local DASH_ADD_MIN, DASH_ADD_MAX = 0, 200
if not BaseWalkSpeed then BaseWalkSpeed = 16 end
if not BaseDashLength then BaseDashLength = 1 end
_G.G_SpeedAdd = math.clamp(tonumber(_G.G_SpeedAdd) or 0, 0, 500)
_G.G_DashAdd = math.clamp(tonumber(_G.G_DashAdd) or tonumber(_G.G_DashLength) or 0, 0, 200)

local function CaptureBaseWalkSpeed(humanoid)
    if not humanoid then return end
    local cur = humanoid.WalkSpeed
    if _G.G_translateAccel and _G.G_SpeedAdd and _G.G_SpeedAdd > 0 then
        local approx = cur - _G.G_SpeedAdd
        if approx >= 8 and approx <= 40 then
            BaseWalkSpeed = approx
            return
        end
    end
    if cur >= 8 and cur <= 40 then
        BaseWalkSpeed = cur
    else
        BaseWalkSpeed = 16
    end
end

local function ApplySpeedBoost(humanoid)
    if not humanoid or not _G.G_translateAccel then return end
    -- 人挤人：直接写 WalkSpeed = translateSpeed（绝对速度）
    local spd = tonumber(_G.G_translateSpeed) or tonumber(_G.G_SpeedAdd) or 50
    if spd < 1 then spd = BaseWalkSpeed + (tonumber(_G.G_SpeedAdd) or 0) end
    humanoid.WalkSpeed = math.clamp(spd, 1, 2000)
end

-- 兼容旧名
local function ApplyTranslateWalkSpeed(humanoid)
    ApplySpeedBoost(humanoid)
end

local function StartTranslateAccel()
    local function bind(char)
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        CaptureBaseWalkSpeed(humanoid)
        ApplySpeedBoost(humanoid)
        if translateWalkSpeedConn then pcall(function() translateWalkSpeedConn:Disconnect() end) end
        translateWalkSpeedConn = nil -- 避免与 SpeedHB 双写
-- 仅 Heartbeat 写速度，避免信号双写
        if translateWalkSpeedConn then pcall(function() translateWalkSpeedConn:Disconnect() end) end
        translateWalkSpeedConn = nil
    end
    if LocalPlayer.Character then bind(LocalPlayer.Character) end
    if translateConnection then pcall(function() translateConnection:Disconnect() end) end
    translateConnection = LocalPlayer.CharacterAdded:Connect(bind)
    track(translateConnection)
end

local function StopTranslateAccel()
    _G.G_translateAccel = false
    if translateWalkSpeedConn then pcall(function() translateWalkSpeedConn:Disconnect() end); translateWalkSpeedConn = nil end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.WalkSpeed = BaseWalkSpeed end) end
end

local speedHB = nil
local function StartSpeedHB()
    if speedHB then return end
    speedHB = RunService.Heartbeat:Connect(function()
        if not ScriptAlive or not _G.G_translateAccel then return end
