local function SafeSendKey(keyName, down)
    keyName = tostring(keyName or ""):upper()
    if keyName == "" or keyName == "NONE" then return end
    local kc = nil
    pcall(function() kc = Enum.KeyCode[keyName] end)
    if not kc then return end
    -- 优先 VirtualInputManager（Xeno 友好）
    local ok = pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(down and true or false, kc, false, game)
    end)
    if ok then return end
    pcall(function()
        if down and keypress then keypress(kc) elseif (not down) and keyrelease then keyrelease(kc) end
    end)
end

local function TapKey(keyName)
    SafeSendKey(keyName, true)
    task.wait(0.025)
    SafeSendKey(keyName, false)
end

local function MarkSkillForAim(keyName)
    if not _G.G_SoruBindAim then return end
    keyName = tostring(keyName):upper()
