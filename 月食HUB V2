end

local function FireSoruAfterSkills()
    local delay = math.clamp(tonumber(_G.G_SoruSkillDelay) or 0.08, 0.0, 0.5)
    task.wait(delay)
    local function fireOne(k)
        k = tostring(k or ""):upper()
        if k == "" then return end
        MarkSkillForAim(k)
        print("[月食] 闪后技能 ->", k)
        -- 1) VirtualInputManager
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local kc = Enum.KeyCode[k]
            if kc then
                vim:SendKeyEvent(true, kc, false, game)
                task.wait(0.05)
                vim:SendKeyEvent(false, kc, false, game)
            end
        end)
        -- 2) keypress
        pcall(function()
            local kc = Enum.KeyCode[k]
            if keypress and keyrelease and kc then
                keypress(kc); task.wait(0.05); keyrelease(kc)
            end
        end)
        -- 3) 工具 RemoteFunction InvokeServer("Z", aimCFrame) 常见于 BF
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local aimPos = currentSilentAimTarget and currentSilentAimTarget.Position
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local cf
            if aimPos and hrp then
                cf = CFrame.new(hrp.Position, aimPos)
            elseif hrp then
                cf = hrp.CFrame
            end
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    local rf = tool:FindFirstChild("RemoteFunction") or tool:FindFirstChildWhichIsA("RemoteFunction")
                    if rf then
                        pcall(function() rf:InvokeServer(k, cf) end)
                        pcall(function() rf:InvokeServer(k) end)
                    end
                    for _, d in ipairs(tool:GetDescendants()) do
                        if d:IsA("RemoteEvent") and (d.Name:find("Skill") or d.Name:find("Move") or d.Name == "RemoteEvent") then
                            pcall(function() d:FireServer(k, cf) end)
                        end
                    end
                end
            end
        end)
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "闪后技能", Content = "已触发 " .. k, Duration = 1.2 })
            end
        end)
    end
    local seq = tostring(_G.G_SoruSkillSeq or "")
    if seq ~= "" then
        for part in string.gmatch(seq, "[^,]+") do
            local k = part:gsub("%s+", ""):upper()
            if k ~= "" then fireOne(k); task.wait(0.06) end
        end
        return
    end
    fireOne(_G.G_SoruSkillKey or "X")
end


