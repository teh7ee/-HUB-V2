-- Potassium/Solara：乱改远程参数会导致技能有动作无特效/直接不放
do
    local okHook, errHook = pcall(function()
        if type(getrawmetatable) ~= "function" or type(newcclosure) ~= "function" then return end
        local mt = getrawmetatable(game)
        if not mt or not mt.__namecall then return end
        local oldNamecall = mt.__namecall
        local FS, IS = "FireServer", "InvokeServer"
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
        if checkcaller and checkcaller() then return oldNamecall(self, ...) end
            if not ScriptAlive or not _G.G_SilentAimSkill or not _G.G_UseNamecallAim then
                return oldNamecall(self, ...)
            end
            local method = getnamecallmethod()
            if method ~= FS and method ~= IS then return oldNamecall(self, ...) end
            if not IsCurrentSkillEnabled() then return oldNamecall(self, ...) end
            local tp = _G.G_SilentAimTargetPos
            if typeof(tp) ~= "Vector3" then return oldNamecall(self, ...) end
            local sName = tostring(self and self.Name or self)
            -- 只碰明显技能远程，避开 CommF_ 等关键远程
            if sName == "CommF_" or sName == "CommF" then return oldNamecall(self, ...) end
            local args = { ... }
            if #args == 0 then return oldNamecall(self, ...) end
            local changed = false
            local left = 1 -- 只改最后一个位置参数，更稳
            for i = #args, 1, -1 do
                if left <= 0 then break end
                local ty = typeof(args[i])
                if ty == "Vector3" then
                    args[i] = tp
                    changed = true
                    left = left - 1
                elseif ty == "CFrame" then
                    args[i] = CFrame.new(tp)
                    changed = true
                    left = left - 1
                end
            end
            if not changed then return oldNamecall(self, ...) end
            return oldNamecall(self, unpack(args))
        end)
        setreadonly(mt, true)
        print("[月食] namecall 钩子已装（默认关闭，技能页可开）")
    end)
    if not okHook then
        warn("[月食] namecall 钩子跳过:", errHook)
        _G.G_UseNamecallAim = false
    end
end

