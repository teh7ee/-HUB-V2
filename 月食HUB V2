function GetClosestTargetToMouse()
    local selecting = (_G.G_SelectPlayerEnabled == true) and _G.G_SilentAimSelectedPlayer and _G.G_SilentAimSelectedPlayer ~= ""
    if not selecting and _G.G_PvPIslandOnly and not IsInPvPCombatZone() then
        return nil
    end

    -- 选择玩家：仍受 FOV 圈限制（圈外不锁）
    if _G.G_SelectPlayerEnabled == true and _G.G_SilentAimSelectedPlayer and _G.G_SilentAimSelectedPlayer ~= "" then
        local name = _G.G_SilentAimSelectedPlayer
        if name and name ~= "" then
            local player = Players:FindFirstChild(name)
            if not player or player == LocalPlayer then return nil end
            -- 指定玩家：不要求队友检测以外的过滤过严；仍排除队友
            if _G.G_SilentAimTeamCheck and not IsSilentAimEnemy(player) then return nil end
            local character = player.Character
            if not IsAlive(character) then return nil end
            local part = character:FindFirstChild(_G.G_SilentAimPart) or character:FindFirstChild("HumanoidRootPart")
            if not part then return nil end
            -- 指定模式：不强制 FOV，始终只锁此人
            return part
        end
    end

    -- 默认：只锁 FOV 圈内（跟随鼠标 / 屏幕中心 都走同一套屏幕距离）
    if not _G.G_SilentAimTargetPlayers and not _G.G_SilentAimTargetMobs then return nil end
    local origin = GetSilentAimOrigin()
    local closest, shortest = nil, math.huge
    local function check(character)
        if not IsAlive(character) then return end
        local part = character:FindFirstChild(_G.G_SilentAimPart) or character:FindFirstChild("HumanoidRootPart")
        if not part then return end
        local pos, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(part.Position)
        if not onScreen or (pos and pos.Z <= 0) then return end
        local dist = (Vector2.new(pos.X, pos.Y) - origin).Magnitude
        local mode = "FOV"
        if type(GetActiveSkillAimMode) == "function" then
            mode = GetActiveSkillAimMode()
        else
            mode = tostring(_G.G_SkillAimMode or _G.G_SilentAimMethod or "FOV")
        end
        local globalMode = (mode == "Global" or mode == "全局" or mode == "全图" or mode == "屏幕最近")
        local fov = tonumber(_G.G_SilentAimFOV) or 150
        if globalMode then
            -- 全局：只要在屏幕内（onScreen）按屏幕距离选最近，不限 FOV 半径
            if dist < shortest then
                closest, shortest = part, dist
            end
        elseif dist <= fov and dist < shortest then
            closest, shortest = part, dist
        end
    end
    if _G.G_SilentAimTargetPlayers then
        for _, player in ipairs(Players:GetPlayers()) do
            if playerAllowed(player) then check(player.Character) end
        end
    end
    if _G.G_SilentAimTargetMobs then
        local folders = {
            Workspace:FindFirstChild("Enemies"),
            Workspace:FindFirstChild("NPCs"),
            Workspace:FindFirstChild("Enemy"),
            Workspace:FindFirstChild("Mobs"),
        }
        -- Sea beasts / 特殊怪有时在 Workspace 直接挂 Model
        for _, folder in ipairs(folders) do
            if folder then
                for _, enemy in ipairs(folder:GetChildren()) do
                    check(enemy)
                end
            end
        end
    end
    return closest
end


