local function CombatLogAdd(kind, name)
    if not name or name == "" then return end
    _G.G_CombatLog = _G.G_CombatLog or { targeted = {}, killed = {} }
    local list = _G.G_CombatLog[kind]
    if type(list) ~= "table" then list = {}; _G.G_CombatLog[kind] = list end
    -- 去重移到最前
    for i = #list, 1, -1 do
        if list[i] == name then table.remove(list, i) end
    end
    table.insert(list, 1, name)
    while #list > 30 do table.remove(list) end
end

