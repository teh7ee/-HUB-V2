-- ESP 绘制
local ESPRenderConn
ESPDrawings = ESPDrawings or {}
if type(ESPDrawings) ~= "table" then ESPDrawings = {} end
local function EnsureESPLoop()
    if ESPRenderConn then return end
    ESPRenderConn = RunService.RenderStepped:Connect(function()
        if not ScriptAlive or not _G.G_ESP then
            pcall(ClearESP)
            return
        end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local seen = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local pos, on = cam:WorldToViewportPoint(hrp.Position)
                    local key = plr.Name
                    seen[key] = true
                    local d = ESPDrawings[key]
                    if not d then
                        d = {}
                        pcall(function()
                            local t = Drawing.new("Text")
                            t.Size = 14; t.Center = true; t.Outline = true
                            t.Color = Color3.fromRGB(255, 80, 80)
                            d.text = t
                        end)
                        ESPDrawings[key] = d
                    end
                    if d.text then
                        if on and pos.Z > 0 then
                            d.text.Visible = true
                            d.text.Position = Vector2.new(pos.X, pos.Y - 20)
                            d.text.Text = string.format("%s [%.0f]", plr.Name, hum.Health)
                        else
                            d.text.Visible = false
                        end
                    end
                end
            end
        end
        for k, d in pairs(ESPDrawings) do
            if not seen[k] then
                pcall(function() if d.text then d.text:Remove() end end)
                ESPDrawings[k] = nil
            end
        end
    end)
    pcall(function() if track then track(ESPRenderConn) end end)
end
local _oldESPFlag = false
track(RunService.Heartbeat:Connect(function()
    if _G.G_ESP and not _oldESPFlag then EnsureESPLoop() end
    _oldESPFlag = _G.G_ESP == true
end))

-- ========== 补全缺失功能实现 ==========
ESPDrawings = ESPDrawings or {}
if type(ClearESP) ~= "function" then
    function ClearESP()
        ESPDrawings = ESPDrawings or {}
        for k, d in pairs(ESPDrawings) do
            pcall(function()
                if typeof(d) == "Instance" and d.Destroy then d:Destroy()
                elseif type(d) == "table" then
                    for _, x in pairs(d) do pcall(function() if x.Remove then x:Remove() elseif x.Destroy then x:Destroy() end end) end
                elseif d and d.Remove then d:Remove()
