local function RegisterKeybindActions()
    local function E(name)
        local api = _G.__Eclipse
        if type(api) == "table" and type(api[name]) == "function" then return api[name] end
        local g = rawget(_G, name)
        if type(g) == "function" then return g end
        -- try current env
        return nil
    end
    local function callE(name, ...)
        local f = E(name)
        if f then
            local ok, err = pcall(f, ...)
            if not ok then warn("[月食]", name, err) end
            return ok
        else
            warn("[月食] 未就绪:", name)
            return false
        end
    end
    KeybindActions.ToggleGUI = function()
        local W = (_G.__Eclipse and _G.__Eclipse.MainWindow) or MainWindow or Window
