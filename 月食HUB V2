-- Dash：原 DashLength + G_DashAdd，持续写回
local DashConnection = nil
local function ManageDashLength()
    if DashConnection then pcall(function() task.cancel(DashConnection) end); DashConnection = nil end
    if not _G.G_DashLengthEnabled then
        local character = LocalPlayer.Character
        if character then
            pcall(function()
                character:SetAttribute("DashLength", nil)
                character:SetAttribute("DashLengthAir", nil)
            end)
        end
        return
    end
    DashConnection = task.spawn(function()
        while ScriptAlive and _G.G_DashLengthEnabled do
            task.wait(0.18)
            local character = LocalPlayer.Character
            if character then
                local cur = character:GetAttribute("DashLength")
                local add = math.clamp(tonumber(_G.G_DashAdd) or 0, DASH_ADD_MIN, DASH_ADD_MAX)
                add = add + (math.random() - 0.5) * 0.12
                -- 避免把「已加量」当成 base：若 cur ≈ base+add 则保持 BaseDashLength
                if typeof(cur) == "number" and cur > 0 and cur < 80 then
                    local maybeBase = cur - add
                    if maybeBase >= 0.5 and maybeBase <= 20 and add > 0 then
                        BaseDashLength = maybeBase
                    elseif add == 0 and cur <= 20 then
                        BaseDashLength = cur
                    end
                end
                local val = math.max(1, (BaseDashLength or 1) + add)
                character:SetAttribute("DashLength", val)
                character:SetAttribute("DashLengthAir", val)
            end
        end
        DashConnection = nil
    end)
end


