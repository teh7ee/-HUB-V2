local function IsGunTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local tip = tostring(tool.ToolTip or "")
    local name = string.lower(tool.Name or "")
    if tip == "Gun" or tip:find("Gun") then return true end
    if tip == "Blox Fruit" or tip == "Melee" or tip == "Sword" then return false end
    -- BF 枪名：Kabucha/Acidum/Serpent/Dual/Flintlock/Cannon 等
    local keys = {"gun","rifle","pistol","kabucha","acidum","serpent","flint","cannon","bazooka","magna","quad","soul","plasma","burst","sniper","shotgun"}
    for _, k in ipairs(keys) do
        if name:find(k, 1, true) then return true end
    end
    -- 有 Shoot / Fire remote 的也当枪
    local hasShoot = false
    pcall(function()
        for _, d in ipairs(tool:GetDescendants()) do
            local n = string.lower(d.Name)
            if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) and (n:find("shoot") or n:find("fire") or n:find("click") or n:find("attack")) then
                hasShoot = true
                break
            end
        end
    end)
    return hasShoot
end

