-- BF 阵营/盟友机制：
-- · Marines：全海军自动盟友，不能互伤，不需 Allies UI
-- · Pirates：同队可互打；仅「加盟友 / Crew 自动盟友」不可打 → 看 Allies UI
-- · 船员、Raid 队友也会进盟友列表
local function IsSilentAimAlly(player)
    if not player or player == LocalPlayer then return false end
    local myTeam = LocalPlayer.Team
    local targetTeam = player.Team
    -- 海军：同为 Marines = 自动盟友
    if myTeam and targetTeam then
        if myTeam.Name == "Marines" and targetTeam.Name == "Marines" then
            return true
        end
    end
    -- 海盗：只查 Allies UI 显式路径，不做深层搜索（避免误判全员盟友）
    local ok, isAlly = pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pg and pg:FindFirstChild("Main")
        if not main then return false end
        local allies = main:FindFirstChild("Allies")
        if not allies then return false end
        local container = allies:FindFirstChild("Container")
        if not container then return false end
        local alliesInner = container:FindFirstChild("Allies")
        if not alliesInner then return false end
        local scrolling = alliesInner:FindFirstChild("ScrollingFrame")
        if not scrolling then return false end
        local frame = scrolling:FindFirstChild("Frame")
        if not frame then return false end
        return frame:FindFirstChild(player.Name) ~= nil
    end)
    return ok and isAlly == true
end

local function IsPlayerInSafeZone(player)
    if not player then return false end
    if player:GetAttribute("PvpDisabled") == true then return true end
    if player:GetAttribute("InSafeZone") == true or player:GetAttribute("SafeZone") == true then return true end
    local char = player.Character
    if not char then return false end
    if char:GetAttribute("InSafeZone") == true or char:GetAttribute("SafeZone") == true then return true end
    -- 不用 ForceField 判断：技能/复活也会挂 FF，会误过滤可打目标
