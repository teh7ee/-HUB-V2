-- 原理：AHK 是系统级按键模拟；这里用 UIS 虚拟与 tool 技能节奏在进程内连按
_G.G_MacroEnabled = _G.G_MacroEnabled or false
_G.G_MacroSequence = _G.G_MacroSequence or "Z,X,C"
_G.G_MacroDelay = math.clamp(tonumber(_G.G_MacroDelay) or 0.25, 0.05, 2)
_G.G_MacroLoop = _G.G_MacroLoop or false
local macroConn = nil

local function PressKeySim(keyName)
    -- 优先 VirtualInputManager；回退 keypress
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local kc = Enum.KeyCode[keyName]
        if vim and kc then
            vim:SendKeyEvent(true, kc, false, game)
            task.wait(0.03)
            vim:SendKeyEvent(false, kc, false, game)
            return
        end
    end)
    pcall(function()
        if keypress and keyrelease and Enum.KeyCode[keyName] then
            keypress(Enum.KeyCode[keyName])
            task.wait(0.03)
            keyrelease(Enum.KeyCode[keyName])
        end
    end)
end

local function RunMacroOnce()
    local seq = tostring(_G.G_MacroSequence or "Z,X,C")
    local delay = math.clamp(tonumber(_G.G_MacroDelay) or 0.25, 0.05, 2)
    for part in string.gmatch(seq, "[^,]+") do
        if not ScriptAlive or not _G.G_MacroEnabled then return end
        local k = part:gsub("%s+", ""):upper()
        if k ~= "" then
            PressKeySim(k)
            -- 技能自瞄窗口：标记按键
            if SkillHeld and SkillPressTime then
                SkillHeld[k] = true
                SkillPressTime[k] = tick()
                LastSkillPressed = k
                task.delay(0.2, function()
                    if SkillHeld then SkillHeld[k] = false end
                end)
            end
            task.wait(delay)
        end
    end
end

