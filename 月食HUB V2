local function BuildServerPlayerList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if not _G.G_SilentAimTeamCheck or IsSilentAimEnemy(p) then
                table.insert(list, p.Name)
            end
        end
    end
    table.sort(list)
    if #list == 0 then list = {"(无玩家)"} end
    return list
end
