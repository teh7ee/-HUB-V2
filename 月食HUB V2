local function GetEquippedCategory()
    local char = LocalPlayer.Character
    if not char then return "Melee" end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        local ew = char:FindFirstChild("EquippedWeapon")
        if ew and ew:IsA("Folder") then
            tool = ew:FindFirstChildOfClass("Tool") or ew:FindFirstChildWhichIsA("Tool")
        end
    end
    if not tool then return "Melee" end
    local tip = tostring(tool.ToolTip or "")
    local name = tostring(tool.Name or ""):lower()
    if tip == "Melee" or tip == "Fighting Style" or tip:find("Melee") or tip:find("Fight") then return "Melee" end
    if tip == "Sword" or tip:find("Sword") then return "Sword" end
    if tip == "Gun" or tip:find("Gun") then return "Gun" end
    if tip == "Blox Fruit" or tip == "Fruit" or tip:find("Fruit") then return "Fruit" end
    -- 部分果实 ToolTip 为空，名称含常见果/技能型
    if tip == "" or tip == "nil" then
        if name:find("fruit") or name:find("-fruit") or name:find("dough") or name:find("dragon")
            or name:find("leopard") or name:find("venom") or name:find("control") or name:find("spirit")
            or name:find("shadow") or name:find("magma") or name:find("light") or name:find("dark")
            or name:find("buddha") or name:find("phoenix") or name:find("portal") or name:find("flame")
            or name:find("ice") or name:find("quake") or name:find("rumble") or name:find("blizzard") then
            return "Fruit"
        end
    end
    if name:find("sword") or name:find("blade") or name:find("katana") or name:find("cdk") or name:find("yama") or name:find("tushita") or name:find("scythe") or name:find("trident") then return "Sword" end
    if name:find("gun") or name:find("rifle") or name:find("pistol") or name:find("kabucha") or name:find("acidum") then return "Gun" end
    if name:find("godhuman") or name:find("sanguine") or name:find("dragon talon") or name:find("electric claw") or name:find("death step") or name:find("sharkman") or name:find("superhuman") or name:find("combat") then return "Melee" end
    if name:find("fruit") then return "Fruit" end
    return "Melee"
end

