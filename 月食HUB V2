        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end
        local add = math.clamp(tonumber(_G.G_SpeedAdd) or 0, SPEED_ADD_MIN, SPEED_ADD_MAX)
        local target = math.max(1, BaseWalkSpeed + add)
        local state = hum:GetState()
        local air = state == Enum.HumanoidStateType.Freefall
            or state == Enum.HumanoidStateType.Jumping
            or state == Enum.HumanoidStateType.Flying
        if air then
            -- 空中不推速度向量；加量约 35%，减轻挂感
            target = math.max(1, BaseWalkSpeed + add * 0.35)
        end
        if math.abs(hum.WalkSpeed - target) > 0.5 then
            hum.WalkSpeed = target
        end
    end)
    track(speedHB)
end

