-- ========== 强力 Noclip（最终覆盖）==========
do
    local ncStepped, ncHeartbeat
    local function setCharNoCollide(char)
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                pcall(function()
                    p.CanCollide = false
                    p.CanTouch = p.CanTouch -- keep
                end)
            end
        end
    end
    function StartNoclip()
        _G.G_Noclip = true
        if ncStepped then pcall(function() ncStepped:Disconnect() end) end
        if ncHeartbeat then pcall(function() ncHeartbeat:Disconnect() end) end
        -- Stepped：物理前关碰撞
        ncStepped = RunService.Stepped:Connect(function()
            if not ScriptAlive or not _G.G_Noclip then return end
            setCharNoCollide(LocalPlayer.Character)
        end)
        -- Heartbeat：再刷一次，防游戏回写
        ncHeartbeat = RunService.Heartbeat:Connect(function()
            if not ScriptAlive or not _G.G_Noclip then return end
            setCharNoCollide(LocalPlayer.Character)
        end)
        if track then
            pcall(track, ncStepped)
            pcall(track, ncHeartbeat)
        end
        -- 角色重生后继续
        pcall(function()
            if LocalPlayer.Character then setCharNoCollide(LocalPlayer.Character) end
        end)
        print("[月食] Noclip ON")
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Noclip", Content = "已开启", Duration = 2 })
            end
        end)
    end
    function StopNoclip()
        _G.G_Noclip = false
        if ncStepped then pcall(function() ncStepped:Disconnect() end); ncStepped = nil end
        if ncHeartbeat then pcall(function() ncHeartbeat:Disconnect() end); ncHeartbeat = nil end
        print("[月食] Noclip OFF")
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Noclip", Content = "已关闭", Duration = 2 })
            end
        end)
    end
    _G.__Eclipse = _G.__Eclipse or {}
    _G.__Eclipse.StartNoclip = StartNoclip
    _G.__Eclipse.StopNoclip = StopNoclip
end

