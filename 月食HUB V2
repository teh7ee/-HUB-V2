local function StartFly()
    StopFly()
    _G.G_FlyEnabled = true
    local function ensureMovers(hrp)
        local bv = hrp:FindFirstChild("EclipseFlyBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "EclipseFlyBV"
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.P = 1250
            bv.Velocity = Vector3.zero
            bv.Parent = hrp
        end
        local bg = hrp:FindFirstChild("EclipseFlyBG")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "EclipseFlyBG"
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 9e4
            bg.Parent = hrp
        end
        return bv, bg
    end
    flyConn = RunService.Heartbeat:Connect(function(dt)
        if not ScriptAlive or not _G.G_FlyEnabled then StopFly() return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
